rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Appointment access goes through the authenticated server API.
    match /organzzaAppointments/{document=**} {
      allow read, write: if false;
    }
    match /organzzaSystem/{document=**} {
      allow read, write: if false;
    }
  }
}
