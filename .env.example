# Configure estas variáveis privadas na Vercel.
FIREBASE_PROJECT_ID=siteteste-dcdca
FIREBASE_CLIENT_EMAIL=copie-client_email-da-conta-de-servico
# Copie private_key da conta de serviço; aceita quebras reais ou \n literais.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUBSTITUA\n-----END PRIVATE KEY-----\n"
ADMIN_PASSWORD=defina-uma-senha-para-a-loja
SESSION_SECRET=gere-um-segredo-aleatorio-de-no-minimo-32-caracteres
# Uso local sem Firebase: omita as três variáveis FIREBASE_*.
# Este modelo não é carregado automaticamente pelo servidor.
# HOST=127.0.0.1
# PORT=4173
# ORGANZZA_DATA_DIR=/caminho/para/volume/persistente
