# Vercel: configure estas variáveis no painel, nunca no código público.
DATABASE_URL=postgresql://usuario:senha@servidor/banco?sslmode=verify-full
ADMIN_PASSWORD=defina-uma-senha-para-a-loja
SESSION_SECRET=gere-um-segredo-aleatorio-de-no-minimo-32-caracteres
# Hospedagem Node tradicional ou uso local (Vercel não precisa destas):
HOST=0.0.0.0
PORT=4173
# Sem DATABASE_URL, somente fora da Vercel, usa arquivo neste diretório.
# ORGANZZA_DATA_DIR=/caminho/para/volume/persistente
