{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "business-info.js",
      "maxDuration": 30
    }
  },
  "rewrites": [{"source":"/api/:path*","destination":"/api/index"}]
}
